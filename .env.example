# Supabase (post-démo: réintroduit avec deferred-auth — voir docs/initiative_wizard/decisions.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenRouter — requis pour /api/chat (conversation engine).
# Server-only (pas de NEXT_PUBLIC_), jamais exposé au browser.
# Obtenir une clé: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optionnel — fallback sur anthropic/claude-sonnet-4-20250514 si vide.
# Liste des modèles: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
